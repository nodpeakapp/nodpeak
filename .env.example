# ─────────────────────────────────────────────────────────────
#  Nodpeak — environment
#  Copy to .env and fill in.  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# Public origin of this install. Used for widget embed snippets,
# CORS, cookie domain and the JSON-LD @id. No trailing slash.
APP_URL=https://nodpeak.example.com
NODE_ENV=production
PORT=3000

# ── Database ─────────────────────────────────────────────────
# SQLite. In Docker this path is inside the `nodpeak_data` volume.
DATABASE_URL=file:/data/nodpeak.db

# ── Auth ─────────────────────────────────────────────────────
# 32+ random bytes. Generate:  openssl rand -base64 48
AUTH_SECRET=change-me-openssl-rand-base64-48
# Session lifetime in days
SESSION_TTL_DAYS=30
# Set to "false" to close public sign-ups on a single-tenant install
ALLOW_REGISTRATION=true

# ── Deployment mode ──────────────────────────────────────────
# selfhost = every user is FREE tier, no billing, no limits
# cloud    = managed multi-tenant, payment webhook upgrades to HOSTED
DEPLOYMENT_MODE=selfhost

# ── Plan limits (cloud mode only) ────────────────────────────
FREE_PROJECT_LIMIT=1
FREE_REVIEW_LIMIT=50
HOSTED_PROJECT_LIMIT=25

# ── Payment webhook ──────────────────────────────────────────
# Shared secret used to verify incoming IPNs (Polar / Lemon Squeezy /
# Paddle). Sent as `x-nodpeak-signature`
# HMAC-SHA256 hex of the raw request body.
PAYMENT_WEBHOOK_SECRET=change-me
# Comma separated list of accepted provider names
PAYMENT_PROVIDERS=polar,lemonsqueezy,paddle

# ── SEO audit ────────────────────────────────────────────────
# Max bytes fetched when auditing a URL (guards against huge pages)
SEO_AUDIT_MAX_BYTES=2000000
SEO_AUDIT_TIMEOUT_MS=10000
# Optional Google PageSpeed Insights key for real mobile speed scores.
# Left empty, mobile speed falls back to a local heuristic.
PAGESPEED_API_KEY=

# ── Rate limiting ────────────────────────────────────────────
FEEDBACK_RATE_LIMIT_PER_HOUR=20
AUDIT_RATE_LIMIT_PER_HOUR=10

# ── Litestream (continuous SQLite backup to S3 / R2) ─────────
# Leave LITESTREAM_ENABLED=false to run without backups.
LITESTREAM_ENABLED=false
LITESTREAM_BUCKET=nodpeak-backups
LITESTREAM_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── TLS (used by deploy.sh + certbot) ────────────────────────
DOMAIN=nodpeak.example.com
CERTBOT_EMAIL=you@example.com
